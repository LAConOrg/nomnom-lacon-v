import csv
from enum import StrEnum
from io import StringIO
from typing import Counter

import click
from icecream import ic


@click.group()
def main(): ...


@main.command()
@click.argument("input_file", type=click.File("r"))
def anonymize(input_file):
    """
    Strip the CSV file generated by the ranks report for use in MPC byelections. Remove:
    - updated
    - category
    - member_name
    - member_email
    - member_number
    - ip_address
    - invalidated

    Additionally, generate a new UUID for each member number, and add that to the output file as "voter_id"

    Input a file, output to stdout.
    """
    # Read the content of the input file
    content = input_file.read()

    # Perform anonymization (this is a placeholder for actual logic)
    anonymized_content = anonymize_content(content)

    # Output the anonymized content
    print(anonymized_content)


def anonymize_content(content):
    reader = csv.DictReader(content.splitlines())
    fieldnames_to_retain = [
        field
        for field in reader.fieldnames
        if field
        not in [
            "updated",
            "category",
            "member_name",
            "member_email",
            "member_number",
            "ip_address",
            "invalidated",
        ]
    ]

    member_to_id_map = {}
    next_voter_id = 42

    output_rows = []

    for row in reader:
        member_number = row.get("member_number")
        if not member_number:
            raise ValueError("Missing member_number in row: {}".format(row))

        if member_number not in member_to_id_map:
            member_to_id_map[member_number] = next_voter_id
            next_voter_id += 1
        voter_id = member_to_id_map[member_number]

        new_row = {"voter_id": voter_id}
        new_row.update(
            {field: row[field] for field in fieldnames_to_retain if field in row}
        )

        output_rows.append(new_row)

    buf = StringIO()
    writer = csv.DictWriter(
        buf, fieldnames=["voter_id"] + fieldnames_to_retain, extrasaction="ignore"
    )

    writer.writeheader()

    writer.writerows(output_rows)

    return buf.getvalue()


if __name__ == "__main__":
    main()
